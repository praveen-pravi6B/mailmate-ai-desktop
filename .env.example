# MailMate AI Desktop — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# ── Google OAuth (Gmail + Calendar — single credentials.json covers both) ────
# Run:  python auth_setup.py
# This opens a browser for consent and saves token.json automatically.

# Path to the OAuth token file generated by auth_setup.py.
GOOGLE_TOKEN_PATH=token.json

# Path to the OAuth client secrets file downloaded from Google Cloud Console.
# APIs to enable: Gmail API + Google Calendar API
# Consent screen: add your Gmail as a test user
# Credentials type: OAuth 2.0 Client ID → Desktop app → Download JSON
GOOGLE_CREDENTIALS_PATH=credentials.json

# ── Google Calendar ──────────────────────────────────────────────────────────
# Target calendar for event creation. "primary" uses your default calendar.
GOOGLE_CALENDAR_ID=primary

# ── Telegram ─────────────────────────────────────────────────────────────────
# Bot token issued by @BotFather.  Keep this secret.
TELEGRAM_BOT_TOKEN=

# Chat ID of the Telegram chat or group where notifications are sent.
# To find yours: send a message to your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and look for "chat": {"id": ...}
TELEGRAM_CHAT_ID=

# ── App settings ─────────────────────────────────────────────────────────────
# Path to the SQLite task database.
DB_PATH=mailmate.db

# How often to poll Gmail, in seconds. Default: 300 (5 minutes).
POLL_INTERVAL=300

# Set to "true" to enable real task creation and notifications.
# Leave as "false" (default) to run in dry-run mode.
LIVE_MODE=false
